# Server-only. Leave blank for deterministic priority rules and manual packing.
# Never prefix this key with NEXT_PUBLIC_. Copy to .env.local for live priority and vision testing.
OPENROUTER_API_KEY=
PASSCHECK_DATABASE_PATH=./data/passcheck.sqlite
# auto: browser-stored demo orders on Vercel; SQLite on a local server.
# Set browser_demo to test Vercel behavior locally. Set sqlite only on a writable server.
PASSCHECK_STORAGE_MODE=auto
# Development only. Ignored by production builds even if true.
PASSCHECK_DEMO_MODE=false
# Optional server-only signing/encryption key for fixed accounts and browser demo orders.
# Keep it stable across deployments to preserve demo sessions and browser workspaces.
PASSCHECK_SESSION_SECRET=
# Prioritization and vision are fixed to google/gemini-2.5-flash; no model shopping in the demo.
